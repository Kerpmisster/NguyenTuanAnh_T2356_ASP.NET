@model IEnumerable<Lab09.Models.Cart>
@{
    ViewData["Title"] = "Giỏ hàng";
    Layout = "~/Views/Shared/_Main.cshtml";
}

<style>
    input {
        outline: none !important; /* Tắt outline */
        border: none !important; /* Tắt border */
        box-shadow: none !important; /* Tắt shadow nếu có */
    }

        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
</style>

<div class="container-fluid mt-3 mb-3">
    <div class="row">
        <div class="col-md-12 cart">
            <div class="container py-4">
                <h2 class="text-center text-secondary font-weight-bold border-bottom pb-2">GIỎ HÀNG</h2>
            </div>
            <div class="box-cart">
                <div class="box-cart-item-box">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-warning text-center" role="alert">
                            Giỏ hàng của bạn đang trống.
                            <a asp-controller="Products" asp-action="Index">
                                <p style="color:blue">bấm vào đây để mua hàng</p>
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var money = item.Price * item.Quantity;
                            <div class="box-cart-border-bottom d-flex justify-content-between align-items-center">
                                <div class="box-cart-item d-flex justify-content-start align-items-center">
                                    <img src="@item.Image.Replace("/Images", "/Img")" alt="@item.Name" class="box-cart-item-img" width="100" />
                                    <div class="d-flex flex-column  ms-3">
                                        <h5 class="fw-bold">@item.Name</h5>
                                        <div class="box-cart-item-btn d-flex align-items-center">
                                            <button class="btn btn-sm btn-outline-secondary qty_btn">
                                                <i class="fa fa-minus"></i>
                                            </button>
                                            <input type="number" class="qty_input form-control form-control-sm w-25 text-center" value="@item.Quantity" />

                                            <button class="btn btn-sm btn-outline-secondary qty_btn">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                        <p>
                                        <p data-price="@item.Price">Giá: <span>@string.Format("{0:#,##0}", @item.Price)</span> VND</p>
                                        <p data-money="@money" class="total-money">Thành tiền: <span id="money">@string.Format("{0:#,##0}", @money)</span> VND</p>
                                    </div>
                                </div>
                                <div class="btn-action">
                                    <a href="/cart/remove/?id=@item.Id" class="btn remove">
                                        <i class="fa-solid fa-xmark"></i>
                                    </a>
                                    <a href="/cart/update/?id=@item.Id&quantity=@item.Quantity" data-id="@item.Id" data-qty="@item.Quantity"
                                       class="btn update">Cập nhật</a>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Any())
                {
                    <div class="box-cart-bill">

                        <h3 class="mb-4"> Tóm tắt đơn hàng </h3>
                        <p class="mb-2">
                            <strong>Tổng thành tiền:</strong>
                            <span id="totalMoney" class="fw-bold">@string.Format("{0:#,##0}", ViewBag.total)</span> VND
                        </p>
                        <p class="mb-2">
                            <strong>Phí vận chuyển:</strong>
                            <span class="ship-money text-success">Free Ship</span><br>
                            <small class="text-muted">(Miễn phí vận chuyển với đơn hàng trên 10 triệu)</small>
                        </p>
                        <p class="mb-4">
                            <strong>Thông tin vận chuyển:</strong> Sản phẩm sẽ được Hoàng Hoan giao trong vòng 2-7 ngày.<br>
                            <strong>Chi tiết liên hệ:</strong> <a href="tel:0978611889" class="text-primary">0978 611 889</a>
                        </p>
                        <div class="cart-box cart-layout border p-3 rounded">
                            <div class="d-flex justify-content-between mb-3">
                                <strong>Tổng tiền:</strong>
                                <span id="totalMoneyPay" class="fw-bold">@string.Format("{0:#,##0}", ViewBag.total)</span> VND
                            </div>
                            <div class="d-flex justify-content-between">
                                <a href="/cart/orders" class="btn btn-primary active">Đặt hàng ngay</a>
                                <a asp-controller="Products" asp-action="Index" class="btn">Tiếp tục mua hàng</a>

                            </div>
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        // Khi nhấn nút giảm
        $('.qty_btn .fa-minus').click(function () {
            let qtyInput = $(this).closest('.box-cart-item-btn').find('.qty_input');
            let qty = parseInt(qtyInput.val());
            let price = parseFloat($(this).closest('.box-cart-item').find('p[data-price]').attr("data-price"));

            if (qty > 1) { // Đảm bảo không giảm xuống dưới 1
                qty -= 1;
                qtyInput.val(qty);
                updateCartItem(this, qty, price);
            }
        });

        // Khi nhấn nút tăng
        $('.qty_btn .fa-plus').click(function () {
            let qtyInput = $(this).closest('.box-cart-item-btn').find('.qty_input');
            let qty = parseInt(qtyInput.val());
            let price = parseFloat($(this).closest('.box-cart-item').find('p[data-price]').attr("data-price"));

            qty += 1;
            qtyInput.val(qty);
            updateCartItem(this, qty, price);
        });

        // Khi thay đổi trực tiếp số lượng
        $('.qty_input').change(function () {
            let qty = parseInt($(this).val());
            if (qty < 1 || isNaN(qty)) qty = 1; // Đảm bảo số lượng hợp lệ
            $(this).val(qty);

            let price = parseFloat($(this).closest('.box-cart-item').find('p[data-price]').attr("data-price"));
            updateCartItem(this, qty, price);
        });

        // Hàm cập nhật thành tiền và tổng tiền
        function updateCartItem(element, qty, price) {
            let money = qty * price;

            // Cập nhật thành tiền
            let totalMoneyElement = $(element).closest('.box-cart-item').find('p.total-money');
            totalMoneyElement.attr("data-money", money);
            let formattedMoney = formatMoney(money, 0, ",", ".");
            totalMoneyElement.find("span#money").text(formattedMoney);

            // Cập nhật tổng tiền giỏ hàng
            let totalCartMoney = calculateTotal();
            $("#totalMoney").text(formatMoney(totalCartMoney, 0, ",", "."));
            $("#totalMoneyPay").text(formatMoney(totalCartMoney, 0, ",", "."));

            // Cập nhật href cho nút "Cập nhật"
            let id = $(element).closest('.box-cart-border-bottom').find('.btn-action .update').attr("data-id");
            let updateLink = "/cart/Update/?id=" + id + "&quantity=" + qty;
            $(element).closest('.box-cart-border-bottom').find('.btn-action .update').attr("href", updateLink);
        }

        // Hàm tính tổng tiền giỏ hàng
        function calculateTotal() {
            let total = 0;
            $("p.total-money").each(function () {
                let itemMoney = parseFloat($(this).attr("data-money"));
                if (!isNaN(itemMoney)) {
                    total += itemMoney;
                }
            });
            return total;
        }

        // Hàm định dạng tiền tệ
        function formatMoney(amount, decimalCount = 2, decimal = ".", thousands = ",") {
            try {
                decimalCount = Math.abs(decimalCount);
                decimalCount = isNaN(decimalCount) ? 2 : decimalCount;

                const negativeSign = amount < 0 ? "-" : "";

                let i = parseInt(amount = Math.abs(Number(amount) || 0).toFixed(decimalCount)).toString();
                let j = (i.length > 3) ? i.length % 3 : 0;

                return negativeSign +
                    (j ? i.substr(0, j) + thousands : '') +
                    i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + thousands) +
                    (decimalCount ? decimal + Math.abs(amount - i).toFixed(decimalCount).slice(2) : "");
            } catch (e) {
                console.log(e);
            }
        }
    });
</script>




